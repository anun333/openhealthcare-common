{
    "name": "anun333/openhealthcare-common",
    "description": "Code shared by the openhealthcare OpenEMR modules: one compatibility layer for OpenEMR 7.0 to 8.5, and a check that translated strings carry no apostrophes or quote marks.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "keywords": ["openemr", "openemr-module"],
    "homepage": "https://github.com/anun333/openhealthcare-common",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "OpenHealthcare\\Common\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenHealthcare\\Common\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
